{
  "name": "@0b5vr/experimental",
  "description": "Experimental edition of 0b5vr",
  "author": "0b5vr",
  "version": "0.10.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/0b5vr/experimental-npm.git"
  },
  "main": "./dist/0b5vr-experimental.cjs",
  "module": "./dist/0b5vr-experimental.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/0b5vr-experimental.mjs",
      "require": "./dist/0b5vr-experimental.cjs"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "/dist/",
    "/types/",
    "/LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "version": "npm run clean && npm run build",
    "dev": "cross-env SERVE=1 node bin/build.js",
    "all": "npm run lint && npm test && npm run clean && npm run build && npm run docs",
    "clean": "rimraf dist/ docs/ types/",
    "test": "vitest run",
    "lint": "biome check ./src",
    "lint-fix": "biome check --write ./src",
    "lint-ci": "biome ci ./src",
    "build": "npm run build-js && npm run build-types",
    "build-js": "node bin/build.js",
    "build-types": "npm run build-types-tsc && npm run build-types-bundle",
    "build-types-tsc": "tsc --declaration --declarationDir ./types --emitDeclarationOnly",
    "build-types-bundle": "node bin/dts-bundle.js",
    "docs": "typedoc --entryPoints ./src/index.ts --out docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "5.0.1",
    "cross-env": "^10.1.0",
    "dts-bundle": "^0.7.3",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
